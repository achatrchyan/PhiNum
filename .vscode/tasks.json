{
    "version": "2.0.0",
    "tasks": [

        {
            "label": "Build Debug",
            "type": "shell",
            "command": "mpic++",
            "args": [
                "-g",
                "-O0",
                "-std=gnu++20",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}_debug",
                "-lfftw3_mpi",
                "-lfftw3",
                "-lm"
            ],
            "problemMatcher": ["$gcc"],
            "group": "build"
        },

        {
            "label": "Build Release",
            "type": "shell",
            "command": "mpic++",
            "args": [
                "-O3",
                "-march=native",
                "-mtune=native",
                "-ffast-math",
                "-std=gnu++20",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}",
                "-lfftw3_mpi",
                "-lfftw3",
                "-lm"
            ],
            "problemMatcher": ["$gcc"],
            "group": "build"
        }
    ]
}