{
    "version": "0.2.0",
    "configurations": [

        {
            "name": "MPI Debug (single process)",
            "type": "cppdbg",
            "request": "launch",

            "program": "${fileDirname}/${fileBasenameNoExtension}_debug",
            "args": [],

            "preLaunchTask": "Build Debug",

            "stopAtEntry": false,
            "cwd": "${workspaceFolder}",
            "externalConsole": false,

            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",

            "setupCommands": [
                {
                    "description": "Enable GDB pretty-printing",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },

        {
            "name": "MPI Release Run (Ctrl+F5)",
            "type": "cppdbg",
            "request": "launch",

            "preLaunchTask": "Build Release",

            "program": "/bin/bash",
            "args": [
                "-c",
                "mpirun -np 4 ${fileDirname}/${fileBasenameNoExtension}"
            ],

            "cwd": "${workspaceFolder}",
            "externalConsole": false
        }
    ]
}